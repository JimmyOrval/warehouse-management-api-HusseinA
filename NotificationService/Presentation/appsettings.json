{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection":
    "Host=localhost;Port=7654;Database=NotificationDb;Username=username;Password=password"
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ]
  },

  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "username",
    "Password": "password",
    "Exchange": "warehouse.events",
    "Queue": "notifications.warehouse-events",
    "RoutingKeys": [ "stock.low", "file.uploaded", "stock.adjusted", "product.created" ],
    "DeadLetterExchange": "warehouse.events.dlx",
    "DeadLetterQueue": "notifications.warehouse-events.dlq"
  },

  "Firebase": {
    "ProjectId": "warehouse-management-api"
  },
  "FirebaseServiceAccountPath": "E:\\D Drive\\ALL CONTENT\\InMind Academy\\Firebase Admin SDK\\warehouse-management-api-firebase-adminsdk-fbsvc-bc3556d46b.json"
}
